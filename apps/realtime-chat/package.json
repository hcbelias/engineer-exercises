{
  "name": "@exercises/realtime-chat",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client --port 3002",
    "build": "tsc -b && vite build client",
    "type-check": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@exercises/eslint-config": "workspace:^",
    "@exercises/prettier-config": "workspace:^",
    "@exercises/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "sass": ">=1.89.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.6"
  },
  "prettier": "@exercises/prettier-config",
  "type": "module"
}
