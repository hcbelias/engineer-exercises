{
  "name": "@exercises/distributed-checkout",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@exercises/eslint-config": "workspace:^",
    "@exercises/prettier-config": "workspace:^",
    "@exercises/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prettier": "@exercises/prettier-config",
  "type": "module"
}
