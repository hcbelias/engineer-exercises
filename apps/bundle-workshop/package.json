{
  "name": "@exercises/bundle-workshop",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3008",
    "build": "tsc -b && vite build",
    "build:report": "tsc -b && vite build --mode report",
    "type-check": "tsc --noEmit",
    "preview": "vite preview --port 3008",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@exercises/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.6"
  }
}
